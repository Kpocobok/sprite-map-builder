# Регистр npm (используем китайское зеркало для быстрой загрузки)
registry=https://registry.npmmirror.com

# Зеркало для Electron (для amd64)
electron_mirror=https://npmmirror.com/mirrors/electron/

# Увеличиваем таймауты для медленных соединений
timeout=60000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Отключаем прогресс-бар для ускорения установки
loglevel=error

# Не отправлять аналитику
fund=false
audit=false

# Кешировать скачанные пакеты
cache-min=999999999
cache-max=0